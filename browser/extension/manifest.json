{
  "manifest_version": 3,
  "name": "gprdock: links no perfil em uso",
  "version": "1.1",
  "description": "Um link aberto a partir de um app web (WhatsApp, Teams...) vai para a janela do navegador que está no perfil do gprdock em uso; janela nova só se ali não houver nenhuma.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
